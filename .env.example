# Copy this file to .env and fill in what you need. .env is never committed.
# All variables are optional; see docs/CONFIGURATION.md.

# Optional AI features (🎯 Study with its ✨ Vary tab): Gemini is asked first. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallback: DeepSeek answers when Gemini's quota runs out (or Gemini fails). Pay-per-use key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# PORT=3000
# WHISPER_MODEL=medium.en
