{
    "name": "yt-altyazi",
    "version": "1.0.0",
    "description": "Watch English videos with sentence-accurate subtitles, local AI translation into your language, click-a-word meanings and shadowing tools. Runs fully offline on your computer.",
    "keywords": ["subtitles", "language-learning", "shadowing", "whisper", "whisper.cpp", "translation", "youtube", "english", "local-first", "offline"],
    "license": "MIT",
    "type": "module",
    "main": "server.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "node server.js --open",
        "dev": "node --watch server.js",
        "setup": "node scripts/setup.mjs",
        "doctor": "node scripts/doctor.mjs",
        "translator": "node scripts/translator.mjs",
        "regroup": "node scripts/regroup.mjs",
        "test": "node --test test/"
    },
    "dependencies": {
        "express": "^4.21.2"
    }
}
